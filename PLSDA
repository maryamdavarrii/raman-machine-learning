# =========================
# Confidence Ellipse
# =========================
def plot_confidence_ellipse(
    ax,
    data,
    n_std=2.0,
    **kwargs
):
    cov = np.cov(
        data,
        rowvar=False
    )

    mean = np.mean(
        data,
        axis=0
    )

    vals, vecs = np.linalg.eigh(cov)

    order = vals.argsort()[::-1]

    vals = vals[order]
    vecs = vecs[:, order]

    width, height = (
        2 * n_std * np.sqrt(vals)
    )

    angle = np.degrees(
        np.arctan2(
            *vecs[:, 0][::-1]
        )
    )

    ellipse = Ellipse(
        xy=mean,
        width=width,
        height=height,
        angle=angle,
        fill=False,
        **kwargs
    )

    ax.add_patch(ellipse)


