def group_accuracy(y_true, y_pred, label_encoder):
    classes = label_encoder.classes_
    acc_dict = {}
    for cls in classes:
        mask = (y_true == label_encoder.transform([cls])[0])
        acc = accuracy_score(y_true[mask], y_pred[mask])
        acc_dict[cls] = acc
    return acc_dict

